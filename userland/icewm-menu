prog "Terminal" utilities-terminal st
prog "XFCE Terminal" utilities-terminal xfce4-terminal
prog "File Manager (Thunar)" system-file-manager thunar
prog "File Manager (PCManFM)" system-file-manager pcmanfm
separator
menu "Internet" applications-internet {
    prog "Firefox" web-browser firefox
    prog "NetSurf" web-browser netsurf
    prog "Badwolf" web-browser badwolf
}
menu "Accessories" applications-accessories {
    prog "Text Editor" accessories-text-editor mousepad
    prog "GNOME Calculator" accessories-calculator gnome-calculator
    prog "XCalc" accessories-calculator xcalc
    prog "Clock" clock xclock
}
menu "System" applications-system {
    prog "btop" utilities-system-monitor st -e btop
    prog "htop" utilities-system-monitor st -e htop
}
menu "Games & Demos" applications-games {
    prog "DOOM (X11)" applications-games /bin/doom_x11
    prog "ClassiCube" applications-games /bin/classicube
    prog "Pong" applications-games /bin/pong
    prog "Raycaster" applications-games /bin/raycast
}
menu "Multimedia" applications-multimedia {
    prog "cmus" multimedia-player st -e cmus
    prog "Audio Player" multimedia-player st -e /bin/asplay /assets/test.wav
}
menu "AvoryOS" applications-system {
    prog "About AvoryOS" help-about /bin/about
    prog "Reboot" system-reboot /bin/reboot
    prog "Shut Down" system-shutdown /bin/shutdown
}
separator
restart "Restart IceWM" icewm icewm
