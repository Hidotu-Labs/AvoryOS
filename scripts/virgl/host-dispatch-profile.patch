+/* Opt-in wall-clock timings of host API dispatch. These do not wait for GPU
+ * completion or claim to measure GPU execution. No clocks run when disabled. */
+static uint64_t vrend_profile_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+static uint64_t vrend_profile_cpu_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+static void vrend_profile_report(struct vrend_decode_ctx *ctx, bool force)
+{
+   if (!ctx->profile.enabled || !ctx->profile.submissions)
+      return;
+   uint64_t elapsed = vrend_profile_now() - ctx->profile.epoch_ns;
+   if (!elapsed || (!force && elapsed < 2000000000ULL))
+      return;
+
+   fprintf(stderr, "AVORY_VIRGL_PROFILE ctx=%u window_ms=%.3f submissions=%" PRIu64
+           " bytes=%" PRIu64 " dispatch_ms=%.3f cpu_ms=%.3f context_ms=%.3f gl_error_ms=%.3f\n",
+           ctx->base.ctx_id, elapsed / 1e6, ctx->profile.submissions,
+           ctx->profile.bytes, ctx->profile.submit_ns / 1e6,
+           ctx->profile.cpu_ns / 1e6, ctx->profile.switch_ns / 1e6, ctx->profile.error_ns / 1e6);
+   bool reported[VIRGL_MAX_COMMANDS] = {false};
+   for (unsigned rank = 0; rank < 8; rank++) {
+      unsigned best = VIRGL_MAX_COMMANDS;
+      for (unsigned cmd = 0; cmd < VIRGL_MAX_COMMANDS; cmd++)
+         if (!reported[cmd] && ctx->profile.calls[cmd] &&
+             (best == VIRGL_MAX_COMMANDS ||
+              ctx->profile.command_ns[cmd] > ctx->profile.command_ns[best]))
+            best = cmd;
+      if (best == VIRGL_MAX_COMMANDS)
+         break;
+      reported[best] = true;
+      fprintf(stderr, "AVORY_VIRGL_PROFILE ctx=%u cmd=%s calls=%" PRIu64
+              " api_ms=%.3f\n", ctx->base.ctx_id,
+              vrend_get_comand_name(best), ctx->profile.calls[best],
+              ctx->profile.command_ns[best] / 1e6);
+   }
+   memset(&ctx->profile, 0, sizeof(ctx->profile));
+   ctx->profile.enabled = true;
+   ctx->profile.epoch_ns = vrend_profile_now();
+}
+
+static int vrend_profile_finish(struct vrend_decode_ctx *ctx, int ret,
+                               uint64_t start, uint64_t start_cpu, size_t bytes)
+{
+   if (!ctx->profile.enabled)
+      return ret;
+   ctx->profile.submit_ns += vrend_profile_now() - start;
+   ctx->profile.cpu_ns += vrend_profile_cpu_now() - start_cpu;
+   ctx->profile.submissions++;
+   ctx->profile.bytes += bytes;
+   vrend_profile_report(ctx, false);
+   return ret;
+}
