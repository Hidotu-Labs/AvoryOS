+#ifdef ENABLE_GBM
+/* NVIDIA's EGL (seen on 620.70) ignores EGL_DMA_BUF_PLANE0_PITCH_EXT for
+ * linear dma-bufs and uses align(width * cpp, 32) instead, which shears
+ * images whose rows are padded, such as Venus WSI buffers (256-byte rows).
+ * VIRGL_DMABUF_PITCH_COPY=0/1 overrides the vendor check. */
+static bool vrend_dmabuf_pitch_from_width(void)
+{
+   static int cached = -1;
+   if (cached < 0) {
+      const char *vendor = (const char *)glGetString(GL_VENDOR);
+      cached = debug_get_bool_option("VIRGL_DMABUF_PITCH_COPY",
+                                     vendor && strstr(vendor, "NVIDIA"));
+   }
+   return cached;
+}
+
+/* The wide import is copied into a texture with an alpha channel; keep the
+ * formats copy-compatible by importing X formats as their A variants. */
+static uint32_t vrend_dmabuf_alpha_format(uint32_t drm_format)
+{
+   switch (drm_format) {
+   case GBM_FORMAT_XRGB8888: return GBM_FORMAT_ARGB8888;
+   case GBM_FORMAT_XBGR8888: return GBM_FORMAT_ABGR8888;
+   case GBM_FORMAT_RGBX8888: return GBM_FORMAT_RGBA8888;
+   case GBM_FORMAT_BGRX8888: return GBM_FORMAT_BGRA8888;
+   case GBM_FORMAT_XRGB2101010: return GBM_FORMAT_ARGB2101010;
+   case GBM_FORMAT_XBGR2101010: return GBM_FORMAT_ABGR2101010;
+   default: return drm_format;
+   }
+}
+
+/* glCopyImageSubData moves raw texels. NVIDIA (620.70) keeps ARGB2101010
+ * EGL images in BGR order behind a GL_RGB10_A2 internal format, so the copy
+ * into a real GL_RGB10_A2 texture exchanges red and blue. Every other WSI
+ * format tested (8888 in both orders, ABGR2101010, ABGR16161616F) copies
+ * unchanged. drm_format is the format the wide image was imported with. */
+static bool vrend_dmabuf_copy_swaps_redblue(uint32_t drm_format)
+{
+   return drm_format == GBM_FORMAT_ARGB2101010;
+}
+
+/* Import a linear dma-buf whose rows are padded as a texture stride/cpp texels
+ * wide, so a driver that derives the pitch from the width still gets the real
+ * pitch, and give gr a plain texture of the guest's size to copy into.
+ * Host GL writes to gr stay in gl_id; this path is only taken for buffers the
+ * guest imports to read, such as Venus WSI images. */
+static int vrend_resource_alloc_pitch_src(struct vrend_resource *gr,
+                                          enum virgl_formats format,
+                                          uint32_t drm_format,
+                                          const struct vrend_renderer_resource_set_type_args *args,
+                                          const int *plane_fds)
+{
+   uint32_t cpp = util_format_get_blocksize(gr->base.format);
+   void *image;
+   GLuint tex;
+   int ret;
+
+   image = virgl_egl_image_from_dmabuf(egl, args->plane_strides[0] / cpp, args->height,
+                                       vrend_dmabuf_alpha_format(drm_format),
+                                       args->modifier, 1, plane_fds,
+                                       args->plane_strides, args->plane_offsets);
+   if (!image)
+      return EINVAL;
+
+   /* Errors of earlier commands were already reported; start clean. */
+   glGetError();
+   glGenTextures(1, &tex);
+   glBindTexture(GL_TEXTURE_2D, tex);
+   if (has_feature(feat_egl_image_storage))
+      glEGLImageTargetTexStorageEXT(GL_TEXTURE_2D, (GLeglImageOES)image, NULL);
+   else
+      glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, (GLeglImageOES)image);
+   glBindTexture(GL_TEXTURE_2D, 0);
+   if (glGetError() != GL_NO_ERROR) {
+      glDeleteTextures(1, &tex);
+      virgl_egl_image_destroy(egl, image);
+      return EINVAL;
+   }
+
+   ret = vrend_resource_alloc_texture_ext(gr, format, NULL, false);
+   if (ret) {
+      glDeleteTextures(1, &tex);
+      virgl_egl_image_destroy(egl, image);
+      return ret;
+   }
+
+   gr->pitch_src_tex = tex;
+   gr->pitch_src_image = image;
+   gr->pitch_src_redblue =
+      vrend_dmabuf_copy_swaps_redblue(vrend_dmabuf_alpha_format(drm_format));
+   vrend_resource_sync_pitch_src(gr);
+   return 0;
+}
