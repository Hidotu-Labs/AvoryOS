+/* AVORYOS P6 C4 debug (temporary): one-line CP/MEC/RLC state dump.
+ *
+ * Deliberately restricted to registers the driver reads elsewhere (or that
+ * this boot already read): CP_MEC_CNTL/CP_CPC_STATUS/MEC instruction pointers
+ * and the CP header-dump registers are NOT safely readable here and hang the
+ * GPU on a read.  CPC_BUSY/RLC_BUSY from GRBM_STATUS2 carry the MEC/RLC
+ * liveness information instead. */
+static void gfx_v10_0_kpi_cp_dump(struct amdgpu_device *adev, const char *tag)
+{
+	u32 cp_stat = RREG32_SOC15(GC, 0, mmCP_STAT);
+	u32 grbm = RREG32_SOC15(GC, 0, mmGRBM_STATUS);
+	u32 grbm2 = RREG32_SOC15(GC, 0, mmGRBM_STATUS2);
+
+	dev_info(adev->dev,
+		 "kpi-trace[%s]: cp_stat=%08x grbm=%08x grbm2=%08x cpc_busy=%u rlc_busy=%u me_busy=%u pf_busy=%u ce_busy=%u me_cntl=%08x rlc_cntl=%08x rlc_stat=%08x boot=%08x\n",
+		 tag, cp_stat, grbm, grbm2,
+		 REG_GET_FIELD(grbm2, GRBM_STATUS2, CPC_BUSY),
+		 REG_GET_FIELD(grbm2, GRBM_STATUS2, RLC_BUSY),
+		 REG_GET_FIELD(cp_stat, CP_STAT, ME_BUSY),
+		 REG_GET_FIELD(cp_stat, CP_STAT, PFP_BUSY),
+		 REG_GET_FIELD(cp_stat, CP_STAT, CE_BUSY),
+		 RREG32_SOC15(GC, 0, mmCP_ME_CNTL),
+		 RREG32_SOC15(GC, 0, mmRLC_CNTL),
+		 RREG32_SOC15(GC, 0, mmRLC_STAT),
+		 RREG32_SOC15(GC, 0, mmRLC_RLCS_BOOTLOAD_STATUS));
+}
+
+/* AVORYOS P6 C4 debug (temporary): one-line KIQ HQD dump. */
+static void gfx_v10_0_kpi_hqd_dump(struct amdgpu_device *adev,
+				   struct amdgpu_ring *ring, const char *tag)
+{
+	u32 active, wptr, rptr, dbctl, pqb, pqctl;
+
+	mutex_lock(&adev->srbm_mutex);
+	nv_grbm_select(adev, ring->me, ring->pipe, ring->queue, 0);
+	active = RREG32_SOC15(GC, 0, mmCP_HQD_ACTIVE);
+	wptr = RREG32_SOC15(GC, 0, mmCP_HQD_PQ_WPTR_LO);
+	rptr = RREG32_SOC15(GC, 0, mmCP_HQD_PQ_RPTR);
+	dbctl = RREG32_SOC15(GC, 0, mmCP_HQD_PQ_DOORBELL_CONTROL);
+	pqb = RREG32_SOC15(GC, 0, mmCP_HQD_PQ_BASE);
+	pqctl = RREG32_SOC15(GC, 0, mmCP_HQD_PQ_CONTROL);
+	nv_grbm_select(adev, 0, 0, 0, 0);
+	mutex_unlock(&adev->srbm_mutex);
+
+	dev_info(adev->dev,
+		 "kpi-trace[%s]: hqd me=%u pipe=%u q=%u active=%08x wptr=%08x rptr=%08x dbctl=%08x pqb=%08x pqctl=%08x\n",
+		 tag, ring->me, ring->pipe, ring->queue, active, wptr, rptr,
+		 dbctl, pqb, pqctl);
+}
