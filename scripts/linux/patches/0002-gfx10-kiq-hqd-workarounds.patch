--- a/drivers/gpu/drm/amd/amdgpu/gfx_v10_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gfx_v10_0.c
@@ -6632,6 +6632,17 @@
 				break;
 			udelay(1);
 		}
+		/* AVORYOS P6 C4: a PCI/VFIO reset does not reset the CP, so a
