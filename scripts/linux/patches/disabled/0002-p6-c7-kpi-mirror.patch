+/* AVORYOS P6 C7 (kpi_mirror): mirror the committed primary planes of every
+ * active stream into the native QEMU-visible display.  A session on this
+ * passed-through GPU scans out to its own (emulated-sink) connector, which
+ * QEMU cannot show; the native side copies the plane into the framebuffer
+ * the VM window scans out.  The plane is CPU-read here, so mirroring also
+ * forces a linear modifier for primary planes (amdgpu_dm_plane.c) and this
+ * hook skips anything else. */
+extern bool ascentdrm_mirror_enabled(void);
+/* Same layout as struct drm_mode_rect; see the native mirror header. */
+struct ascentdrm_mirror_rect {
+	s32 x1, y1, x2, y2;
+};
+
+extern void ascentdrm_mirror_present(const void *pixels, u32 width, u32 height,
+				     u32 pitch, u32 format,
+				     const struct ascentdrm_mirror_rect *rects,
+				     u32 nrects);
+
+/* The scanout BOs stay kmapped between frames: mapping a multi-megabyte
+ * VRAM BO can ioremap/vmap it and would otherwise be redone on every
+ * commit.  Compositors double- or triple-buffer, so keep a few entries;
+ * only the mirror worker touches this cache and the BO references keep the
+ * buffers alive while they are mapped. */
+#define DM_MIRROR_MAP_ENTRIES 4
+#define DM_MIRROR_MAX_RECTS 16
+
+struct dm_mirror_map {
+	struct amdgpu_bo *bo;
+	void *kptr;
+	bool owned;
+	u32 used;
+};
+
+static struct dm_mirror_map dm_mirror_maps[DM_MIRROR_MAP_ENTRIES];
+static u32 dm_mirror_map_tick;
+
+/* The copy runs in a work item instead of the commit tail: a CPU read of a
+ * 1080p scanout costs milliseconds and would otherwise be added to every
+ * flip's completion latency.  The commit tail only records the newest frame
+ * (BO reference + geometry) and schedules the worker; the worker loops until
+ * it has copied that newest frame.  A dedicated queue keeps the long copy
+ * away from the shared system workqueue. */
+static DEFINE_SPINLOCK(dm_mirror_lock);
+static struct amdgpu_bo *dm_mirror_frame_bo;
+static u32 dm_mirror_frame_w, dm_mirror_frame_h, dm_mirror_frame_pitch;
+static u32 dm_mirror_frame_format, dm_mirror_frame_offset;
+static u32 dm_mirror_frame_nrects;
+static struct ascentdrm_mirror_rect dm_mirror_frame_rects[DM_MIRROR_MAX_RECTS];
+static u32 dm_mirror_seq, dm_mirror_copied_seq;
+static struct workqueue_struct *dm_mirror_wq;
+
+static void amdgpu_dm_mirror_work_fn(struct work_struct *work);
+static DECLARE_WORK(dm_mirror_work, amdgpu_dm_mirror_work_fn);
+
+static void amdgpu_dm_mirror_unmap_entry(struct dm_mirror_map *m)
+{
+	if (m->bo) {
+		if (m->owned)
+			amdgpu_bo_kunmap(m->bo);
+		amdgpu_bo_unref(&m->bo);
+	}
+	m->bo = NULL;
+	m->kptr = NULL;
+	m->owned = false;
+}
+
+static void amdgpu_dm_mirror_unmap_all(void)
+{
+	u32 i;
+
+	for (i = 0; i < DM_MIRROR_MAP_ENTRIES; i++)
+		amdgpu_dm_mirror_unmap_entry(&dm_mirror_maps[i]);
+}
+
+static void *amdgpu_dm_mirror_map(struct amdgpu_bo *bo)
+{
+	struct dm_mirror_map *m = NULL;
+	void *kptr = NULL;
+	bool owned;
+	u32 i;
+
+	for (i = 0; i < DM_MIRROR_MAP_ENTRIES; i++) {
+		if (dm_mirror_maps[i].bo == bo) {
+			dm_mirror_maps[i].used = ++dm_mirror_map_tick;
+			return dm_mirror_maps[i].kptr;
+		}
+		if (!dm_mirror_maps[i].bo && !m)
+			m = &dm_mirror_maps[i];
+	}
+
+	if (!m) {
+		m = &dm_mirror_maps[0];
+		for (i = 1; i < DM_MIRROR_MAP_ENTRIES; i++)
+			if (dm_mirror_maps[i].used < m->used)
+				m = &dm_mirror_maps[i];
+		amdgpu_dm_mirror_unmap_entry(m);
+	}
+
+	/* Keep an existing kernel mapping alive (do not steal it). */
+	owned = (amdgpu_bo_kptr(bo) == NULL);
+
+	if (amdgpu_bo_kmap(bo, &kptr) || !kptr) {
+		pr_warn_once("kpi_mirror: kmap of the primary plane failed\n");
+		return NULL;
+	}
+
+	m->bo = amdgpu_bo_ref(bo);
+	m->kptr = kptr;
+	m->owned = owned;
+	m->used = ++dm_mirror_map_tick;
+
+	return kptr;
+}
+
+/* Drop the recorded frame, then release the cached mapping.  Called once no
+ * CRTC drives a stream anymore (session exit or modeset disable). */
+static void amdgpu_dm_mirror_stop(void)
+{
+	unsigned long flags;
+	struct amdgpu_bo *bo;
+
+	spin_lock_irqsave(&dm_mirror_lock, flags);
+	bo = dm_mirror_frame_bo;
+	dm_mirror_frame_bo = NULL;
+	spin_unlock_irqrestore(&dm_mirror_lock, flags);
+
+	if (bo)
+		amdgpu_bo_unref(&bo);
+
+	flush_work(&dm_mirror_work);
+	amdgpu_dm_mirror_unmap_all();
+}
+
+static void amdgpu_dm_mirror_queue(struct amdgpu_bo *bo,
+				   const struct drm_framebuffer *fb,
+				   const struct drm_plane_state *plane_state)
+{
+	unsigned long flags;
+	struct amdgpu_bo *prev;
+	const struct drm_mode_rect *clips;
+	u32 nclips;
+	bool full;
+
+	/* The compositor's FB_DAMAGE_CLIPS (Weston sets it; the driver enables
+	 * the property) lets the mirror copy only what changed.  No clips,
+	 * too many, or a frame that has not been copied yet falls back to a
+	 * full-frame copy. */
+	clips = drm_plane_get_damage_clips(plane_state);
+	nclips = clips ? (u32)drm_plane_get_damage_clips_count(plane_state) : 0;
+	full = (!clips || !nclips || nclips > DM_MIRROR_MAX_RECTS);
+
+	amdgpu_bo_ref(bo);
+
+	spin_lock_irqsave(&dm_mirror_lock, flags);
+	prev = dm_mirror_frame_bo;
+	dm_mirror_frame_bo = bo;
+	dm_mirror_frame_w = fb->width;
+	dm_mirror_frame_h = fb->height;
+	dm_mirror_frame_pitch = fb->pitches[0];
+	dm_mirror_frame_format = fb->format->format;
+	dm_mirror_frame_offset = fb->offsets[0];
+	if (dm_mirror_seq != dm_mirror_copied_seq)
+		full = true;
+	if (full) {
+		dm_mirror_frame_nrects = 0;
+	} else {
+		memcpy(dm_mirror_frame_rects, clips,
+		       (size_t)nclips * sizeof(dm_mirror_frame_rects[0]));
+		dm_mirror_frame_nrects = nclips;
+	}
+	dm_mirror_seq++;
+	spin_unlock_irqrestore(&dm_mirror_lock, flags);
+
+	if (prev)
+		amdgpu_bo_unref(&prev);
+
+	if (!dm_mirror_wq)
+		dm_mirror_wq = alloc_workqueue("avory-mirror", 0, 1);
+	if (dm_mirror_wq)
+		queue_work(dm_mirror_wq, &dm_mirror_work);
+	else
+		schedule_work(&dm_mirror_work);
+}
+
+static void amdgpu_dm_mirror_work_fn(struct work_struct *work)
+{
+	for (;;) {
+		unsigned long flags;
+		struct amdgpu_bo *bo;
+		struct ascentdrm_mirror_rect rects[DM_MIRROR_MAX_RECTS];
+		u32 w, h, pitch, format, offset, seq, nrects;
+		const void *kptr;
+		bool more;
+
+		spin_lock_irqsave(&dm_mirror_lock, flags);
+		bo = dm_mirror_frame_bo;
+		if (bo)
+			amdgpu_bo_ref(bo);
+		w = dm_mirror_frame_w;
+		h = dm_mirror_frame_h;
+		pitch = dm_mirror_frame_pitch;
+		format = dm_mirror_frame_format;
+		offset = dm_mirror_frame_offset;
+		seq = dm_mirror_seq;
+		nrects = dm_mirror_frame_nrects;
+		if (nrects)
+			memcpy(rects, dm_mirror_frame_rects,
+			       (size_t)nrects * sizeof(rects[0]));
+		spin_unlock_irqrestore(&dm_mirror_lock, flags);
+
+		if (!bo)
+			return;
+
+		kptr = amdgpu_dm_mirror_map(bo);
+		if (kptr)
+			ascentdrm_mirror_present((const u8 *)kptr + offset,
+						 w, h, pitch, format,
+						 nrects ? rects : NULL, nrects);
+
+		amdgpu_bo_unref(&bo);
+
+		spin_lock_irqsave(&dm_mirror_lock, flags);
+		dm_mirror_copied_seq = seq;
+		more = (dm_mirror_seq != dm_mirror_copied_seq);
+		spin_unlock_irqrestore(&dm_mirror_lock, flags);
+
+		if (!more)
+			return;
+	}
+}
+
+static bool amdgpu_dm_mirror_has_stream(struct drm_device *dev)
+{
+	struct drm_crtc *crtc;
+
+	drm_for_each_crtc(crtc, dev) {
+		struct dm_crtc_state *dm_state = to_dm_crtc_state(crtc->state);
+
+		if (dm_state && dm_state->stream)
+			return true;
+	}
+
+	return false;
+}
+
+static void amdgpu_dm_mirror_planes(struct drm_atomic_state *state)
+{
+	struct drm_crtc *crtc;
+	struct drm_crtc_state *new_crtc_state;
+	u32 i;
+
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		struct dm_crtc_state *dm_new_crtc_state =
+			to_dm_crtc_state(new_crtc_state);
+		struct drm_plane_state *new_plane_state;
+		struct drm_framebuffer *fb;
+		struct amdgpu_framebuffer *afb;
+		struct amdgpu_bo *bo;
+
+		if (!dm_new_crtc_state->stream || !crtc->primary)
+			continue;
+
+		new_plane_state =
+			drm_atomic_get_new_plane_state(state, crtc->primary);
+		if (!new_plane_state || !new_plane_state->fb)
+			continue;
+
+		fb = new_plane_state->fb;
+		afb = to_amdgpu_framebuffer(fb);
+		/* LINEAR is authoritative here: the driver converts legacy
+		 * tiling flags to a modifier (SWIZZLE_MODE == 0 -> LINEAR), and
+		 * only a swizzled layout is CPU-unreadable.  Keep the explicit
+		 * swizzle test for the non-modifier path. */
+		if (fb->modifier != DRM_FORMAT_MOD_LINEAR ||
+		    AMDGPU_TILING_GET(afb->tiling_flags, SWIZZLE_MODE) ||
+		    !fb->obj[0] || !fb->pitches[0] || !fb->format) {
+			pr_warn_once("kpi_mirror: skipping primary plane (modifier=0x%llx tiling=0x%llx)\n",
+				     (unsigned long long)fb->modifier,
+				     (unsigned long long)afb->tiling_flags);
+			continue;
+		}
+
+		bo = gem_to_amdgpu_bo(fb->obj[0]);
+		amdgpu_dm_mirror_queue(bo, fb, new_plane_state);
+	}
+
+	if (!amdgpu_dm_mirror_has_stream(state->dev))
+		amdgpu_dm_mirror_stop();
+}
